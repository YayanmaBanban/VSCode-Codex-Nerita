{
	// Storybook・Vitest の設定は、Extension Host と独立したブラウザ用環境で検査する。
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"jsx": "react-jsx",
		"types": ["node", "vite/client"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
