{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "svelte"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"rootDir": "../..",
		"noEmit": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"],
	"exclude": []
}
