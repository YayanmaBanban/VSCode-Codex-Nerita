{
	"name": "@nerita/ui",
	"private": true,
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && svelte-check --tsconfig ./stories/tsconfig.json --fail-on-warnings && tsc -p tsconfig.tools.json",
		"build": "node build.cjs",
		"storybook": "storybook dev -p 6006 --config-dir .storybook",
		"build-storybook": "storybook build --config-dir .storybook --output-dir ../../dist/storybook",
		"test:storybook": "vitest run --config vitest.config.mts"
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "2.1.3",
