		"@lexical/plain-text": "0.50.0",
		"@lucide/svelte": "1.55.0",
		"@nerita/shared": "workspace:*",
		"@tanstack/svelte-virtual": "3.13.41",
		"@xyflow/svelte": "1.7.0",
		"bits-ui": "2.19.5",
		"cnfast": "^0.2.0",
		"diff": "8.0.4",
		"lexical": "^0.50.0",
		"motion": "^13.5.1",
		"smol-toml": "^1.8.0",
		"svelte": "^5.57.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@storybook/addon-mcp": "^10.6.1",
		"@storybook/addon-vitest": "^10.6.1",
		"@storybook/svelte-vite": "10.6.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "24.x",
		"@vitest/browser-playwright": "latest",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "^10.6.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "latest"
	}
}
