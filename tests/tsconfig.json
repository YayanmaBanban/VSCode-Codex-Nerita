{
	// 本体と同じ型安全性・module 設定を継承し、テストだけ別基準にならないようにする。
	"extends": "../tsconfig.json",
	"compilerOptions": {
		// Vitest 依存宣言の DOM 型参照を Host の実行環境へ持ち込まない。
		"skipLibCheck": true,
		// Lexicalの参照ノードが描画するReact部品も単体テストから検査する。
		"jsx": "react-jsx",
		// tests から src も参照するため、両方を含む共通ルートを指定する。
		"rootDir": "..",

		// 実機テストの出力は esbuild に任せ、ここでは型だけを検査する。
		"noEmit": true,

		// テストでは Node.js に加えて Mocha の suite / test などのグローバル型を利用する。
		"types": ["node", "mocha"]
	},

	// typed lint の Project Service と tsc の双方から、本体とテストを同じテストProjectとして見せる。
	"include": [
		"../apps/vscode-nerita/src/extension/**/*.ts",
		"../packages/shared/src/**/*.ts",
		"./**/*.ts"
	],
	"exclude": ["../node_modules", "e2e"]
}
