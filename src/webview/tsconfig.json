{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"rootDir": "..",
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"../shared/**/*.ts",
		"../hooks/**/*.tsx",
		"../lib/**/*.ts"
	],
	"exclude": []
}
