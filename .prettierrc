{
	"useTabs": true,
	"bracketSpacing": true,
	"tabWidth": 4,
	"tailwindStylesheet": "./apps/nerita-ui/src/chat/tailwind.css",
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": "apps/nerita-ui/stories/**/*.svelte",
			"options": {
				"tailwindStylesheet": "./apps/nerita-ui/.storybook/tailwind.css"
			}
		}
	]
}
