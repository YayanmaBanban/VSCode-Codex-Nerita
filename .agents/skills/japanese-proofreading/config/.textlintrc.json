{
	"filters": {
		"comments": true
	},
	"rules": {
		"preset-ja-technical-writing": {
			"no-mix-dearu-desumasu": {
				"preferInList": ""
			}
		},

		"@textlint-ja/preset-ai-writing": {
			"ai-tech-writing-guideline": {
				"disableRedundancyGuidance": false,
				"disableVoiceGuidance": false,
				"disableClarityGuidance": false,
				"disableConsistencyGuidance": false,
				"disableStructureGuidance": false,
				"enableDocumentAnalysis": true
			}
		},

		"@textlint-rule/pattern": {
			"patterns": [
				{
					"message": "英語・識別子と日本語が直接接続されています。コード識別子なら維持し、一般的な技術用語なら自然な日本語への言い換えを検討してください。",
					"pattern": "/[A-Za-z][A-Za-z0-9_.+#:@-]*(?=[ぁ-んァ-ヶ一-龠々ー])/u"
				},
				{
					"message": "日本語と英語・識別子が直接接続されています。固有名詞・識別子か一般用語かを文脈から判断して修正してください。",
					"pattern": "/[ぁ-んァ-ヶ一-龠々ー](?=[A-Za-z][A-Za-z0-9_.+#:@-]*)/u"
				},
				{
					"message": "「実 + 英語名詞」の表現は避けてください。「実際の〜」「〜本体」など、文脈に合う自然な表現へ書き換えてください。",
					"pattern": "/実\\s*(?=(?:`[^`]+`|[A-Za-z][A-Za-z0-9_.+#:@/-]*))/u"
				}
			]
		}
	}
}
