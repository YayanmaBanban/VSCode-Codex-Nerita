// F5で必要な資産をビルドし、同じワークスペースを開いた開発用Hostを起動する。
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--new-window",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}/.vscode/development.code-workspace",
				"--disable-extension",
				"jgclark.vscode-todo-highlight",
				"--disable-extension",
				"bradlc.vscode-tailwindcss",
				"--disable-extension",
				"GitHub.vscode-pull-request-github"
			],
			"outFiles": ["${workspaceFolder}/dist/extension.js"],
			"sourceMaps": true,
			"preLaunchTask": "build: extension"
		}
	]
}
