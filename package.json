{
	"name": "nerita-codex",
	"displayName": "Nerita for Codex",
	"description": "codex-app-serverを利用した、Codex用のVSCode拡張機能",
	"repository": {
		"type": "git",
		"url": "https://github.com/YayanmaBanban/VSCode-Codex-Nerita"
	},
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.137.0"
	},
	"categories": [
		"AI",
		"Other"
	],
	"activationEvents": [],
	"publisher": "nerita-local",
	"icon": "media/nerita_store_icon.png",
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Codexは信頼済みワークスペース内でファイル・コマンド操作を実行します。"
		},
		"virtualWorkspaces": false
	},
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"title": "Nerita for Codex",
			"properties": {
				"nerita.backend": {
					"type": "string",
					"enum": [
						"codex",
						"pi"
					],
					"default": "codex",
					"scope": "window",
					"description": "チャットに使用するエージェント。オプションから変更するとバックエンドだけを再起動し、新しい会話を開始します。設定ファイルで変更した場合はウィンドウを再読み込みしてください。Piの書き込み・PowerShell実行には毎回の承認が必要です。"
				},
				"nerita.pi.sessionStorage": {
					"type": "string",
					"enum": [
						"global",
						"workspace"
					],
					"default": "global",
					"scope": "window",
					"enumDescriptions": [
						"Pi標準の ~/.pi/agent/sessions/ に保存",
						"ワークスペースの .sessions/ に保存"
					],
					"markdownDescription": "Piの新規会話の保存先。未送信の新規会話では初回送信時にも設定変更を反映します。送信済み・復元済みの会話は元の保存先を維持します。workspaceでは `.sessions/.gitignore` を内容 `*` で初回生成します。既存ファイルは上書きしません。"
				},
				"nerita.pi.trustedExtensionPaths": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"default": [],
					"scope": "application",
					"markdownDescription": "Pi拡張のロードを許可するcanonicalな絶対ファイルパス。ユーザー設定だけを使用し、ディレクトリや未指定のentryはロードしません。依存コードを含むHost権限の実行を信頼する設定です。Toolは毎回承認しますが、任意JavaScriptやHTTP通信をShell Sandboxで隔離する保証ではありません。変更はPiへの再接続後に反映されます。"
				},
				"nerita.codex.changes.exclude": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"default": [
						"**/*.lock",
						"**/package-lock.json",
						"**/pnpm-lock.yaml",
						"**/yarn.lock",
						"**/dist/**",
						"**/build/**",
						"**/generated/**",
						"**/*.generated.*"
					],
					"scope": "resource",
					"markdownDescription": "変更点のプレビュー・送信から除外するGit globパターン。リポジトリルートからの相対パスを `/` 区切りで指定します（例: `**/coverage/**`）。設定した配列で既定値全体を置き換えます。`[]` で除外を無効にできます。ユーザー・ワークスペース・フォルダー単位で設定でき、次回の差分取得から反映されます。"
				},
				"nerita.codex.sidebarLocation": {
					"type": "string",
					"enum": [
						"primary",
						"secondary"
					],
					"enumDescriptions": [
						"プライマリ サイドバー",
						"セカンダリ サイドバー"
					],
					"default": "secondary",
					"scope": "application",
					"description": "Codexチャットを表示するサイドバー。"
				}
			}
		},
		"commands": [
			{
				"command": "nerita.pi.setupCodexWindowsSandbox",
				"title": "Nerita: Pi用のCodex Windows Sandboxをセットアップ",
				"enablement": "isWindows && config.nerita.backend == pi"
			},
			{
				"command": "nerita.codex.codeBlock",
				"title": "コードブロック化"
			},
			{
				"command": "nerita.codex.openChat",
				"title": "Nerita for Codex: チャットを開く"
			},
			{
				"command": "nerita.codex.newSession",
				"title": "Nerita for Codex: 新規会話"
			}
		],
		"menus": {
			"webview/context": [
				{
					"command": "nerita.codex.codeBlock",
					"when": "(webviewId == 'nerita.codex.chat' || webviewId == 'nerita.codex.editor') && webviewSection == 'composer' && composerCanCodeBlock",
					"group": "edit@10"
				}
			],
			"commandPalette": [
				{
					"command": "nerita.pi.setupCodexWindowsSandbox",
					"when": "isWindows && config.nerita.backend == pi"
				},
				{
					"command": "nerita.codex.codeBlock",
					"when": "false"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "nerita-primary",
					"title": "Nerita for Codex",
					"icon": "media/nerita.svg"
				}
			],
			"secondarySidebar": [
				{
					"id": "nerita",
					"title": "Nerita for Codex",
					"icon": "media/nerita.svg"
				}
			]
		},
		"views": {
			"nerita-primary": [],
			"nerita": [
				{
					"id": "nerita.codex.chat",
					"name": "Nerita for Codex",
					"type": "webview",
					"icon": "media/nerita.svg"
				}
			]
		}
	},
	"scripts": {
		"codex:generate": "node config/generate-codex.cjs",
		"pi:generate": "node config/generate-pi.cjs",
		"pi:verify": "node config/verify-pi.cjs",
		"compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
		"compile-tests": "tsc -p tests/tsconfig.json",
		"pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
		"package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
		"package:vsix": "vsce package --no-dependencies --target win32-x64 --out dist/nerita.vsix",
		"vscode:prepublish": "pnpm run package",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch-tests": "tsc -p tests/tsconfig.json -w",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"watch:webview": "tsc -p src/webview/tsconfig.json --watch",
		"check": "pnpm lint && pnpm check-types && pnpm check-types:tests",
		"check-types": "tsc --noEmit && tsc -p src/webview/tsconfig.json && tsc -p src/stories/tsconfig.json",
		"check-types:tests": "tsc --noEmit -p tests/tsconfig.json",
		"check-types:tools": "tsc -p config/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"textlint": "node scripts/textlint.mjs --all",
		"textlint:changed": "node scripts/textlint.mjs --changed",
		"test": "vscode-test --config tests/.vscode-test.mjs",
		"verify": "pnpm check && pnpm test",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"storybook": "storybook dev -p 6006 --config-dir config/storybook",
		"build-storybook": "storybook build --config-dir config/storybook --output-dir dist/storybook",
		"test:storybook": "vitest run --config config/vitest.config.ts",
		"ui-review": "playwright test --config tests/e2e/config/ui-review.config.ts",
		"ui-review:chat": "pnpm ui-review chat",
		"ui-review:report": "playwright show-report dist/ui-review/report",
		"test:unit": "vitest run --config config/vitest.host.config.ts",
		"test:codex": "node tests/codex-app-server-smoke.mjs",
		"test:codex:chat": "node tests/codex-chat-smoke.mjs",
		"test:pi:chat": "node tests/pi-chat-smoke.mjs",
		"test:pi:shell": "node tests/pi-shell-smoke.mjs",
		"test:sandbox": "node tests/sandbox-smoke.mjs",
		"test:runtime": "node --test tests/runtime-packaging.test.mjs tests/pi-runtime-packaging.test.mjs tests/pi-update.test.cjs tests/license-cleanup.test.cjs",
		"test:codex:features": "node tests/codex-features-smoke.mjs",
		"test:codex:history": "node tests/codex-history-smoke.mjs"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-mcp": "^10.6.0",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
		"@textlint-rule/textlint-rule-pattern": "^2.0.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/vscode": "^1.137.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/browser-playwright": "latest",
		"@vitest/coverage-v8": "latest",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.0",
		"globals": "^17.12.0",
		"ignore": "^7.0.10",
		"npm-run-all": "^4.1.5",
		"playwright": "latest",
		"postcss": "^8.5.28",
		"prettier": "^3.9.6",
		"storybook": "^10.6.0",
		"tailwindcss": "4.3.3",
		"textlint": "^15.8.0",
		"textlint-rule-preset-ja-technical-writing": "^12.0.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vite": "^8.3.0",
		"vitest": "latest"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@lexical/link": "^0.50.0",
		"@lexical/react": "^0.50.0",
		"@openai/codex": "0.156.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"diff": "8.0.4",
		"framer-motion": "^13.3.0",
		"gsap": "^3.15.0",
		"lexical": "^0.50.0",
		"lightswind": "^3.2.5",
		"lucide-react": "^1.45.0",
		"motion": "^13.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"smol-toml": "^1.8.0",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	}
}
