{
	"name": "nerita-workspace",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"handoff:generate": "node scripts/generate-handoff-schema.cjs",
		"guardrails:generate": "node scripts/generate-guardrails-schema.cjs",
		"test:guardrails:ui": "pnpm build:shared && node tests/guardrails-vscode-smoke.mjs",
		"test:workflow:ui": "pnpm build:shared && node tests/workflow-vscode-smoke.mjs",
		"test:pi:subagents": "pnpm build:shared && node tests/pi-subagents-package-smoke.mjs",
		"test:pi:workflow": "pnpm build:shared && node tests/pi-workflow-package-smoke.mjs",
		"codex:generate": "node config/generate-codex.cjs",
		"pi:generate": "node config/generate-pi.cjs",
		"pi:verify": "node config/verify-pi.cjs",
		"compile": "pnpm check-types && pnpm lint && pnpm build",
		"compile-tests": "pnpm build:shared && pnpm check-types:tests && node config/build-vscode-tests.cjs",
		"pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
		"package": "pnpm check-types && pnpm lint && pnpm build:shared && pnpm --filter @nerita/ui build --production && pnpm --filter nerita package",
		"package:vsix": "pnpm --filter nerita package:vsix",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "pnpm build:shared && pnpm --filter nerita watch",
		"watch-tests": "npm-run-all -p test-watch:*",
		"watch:tsc": "pnpm --filter nerita exec tsc --noEmit --watch -p tsconfig.json",
		"watch:webview": "pnpm --filter @nerita/ui exec tsc -p tsconfig.json --watch",
		"check": "pnpm lint && pnpm check-types && pnpm check-types:tests",
		"check-types": "pnpm --filter nerita check && pnpm --filter @nerita/shared check && pnpm --filter @nerita/ui check",
		"check-types:tests": "tsc --noEmit -p tests/tsconfig.json",
		"check-types:tools": "tsc -p config/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"textlint": "node scripts/textlint.mjs --all",
		"textlint:changed": "node scripts/textlint.mjs --changed",
		"textlint:review": "node scripts/textlint.mjs --review-all",
		"textlint:review:changed": "node scripts/textlint.mjs --review-changed",
		"textlint:clean": "node scripts/textlint.mjs --clean",
		"test": "node config/run-vscode-tests.cjs",
		"test:vsix": "pnpm compile-tests && pnpm package:vsix && node config/run-vscode-tests.cjs --vsix",
		"verify": "pnpm check && pnpm test",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"storybook": "pnpm --filter @nerita/ui storybook",
		"build-storybook": "pnpm --filter @nerita/ui build-storybook",
		"test:storybook": "pnpm --filter @nerita/ui test:storybook",
		"ui-review": "playwright test --config tests/e2e/config/ui-review.config.ts",
		"ui-review:chat": "pnpm ui-review chat",
		"ui-review:report": "playwright show-report dist/ui-review/report",
		"test:unit": "node config/run-host-tests.cjs tests/unit",
		"test:host": "node config/run-host-tests.cjs",
		"test:regressions": "node config/run-regressions.cjs",
		"test:contract": "node config/run-host-tests.cjs tests/contract",
		"test:integration": "node config/run-host-tests.cjs tests/integration",
		"test:tooling": "node --test tests/textlint-*.test.mjs",
		"test:all": "pnpm test:local && pnpm test:ui && pnpm test:environment",
		"test:codex": "pnpm build:shared && node tests/codex-app-server-smoke.mjs",
		"test:codex:chat": "pnpm build:shared && node tests/codex-chat-smoke.mjs",
		"test:pi:chat": "pnpm build:shared && node tests/pi-chat-smoke.mjs",
		"test:pi:shell": "pnpm build:shared && node tests/pi-shell-smoke.mjs",
		"test:pi:web": "pnpm build:shared && node tests/pi-web-access-smoke.mjs",
		"test:sandbox:ui": "pnpm build:shared && node tests/vscode-sandbox-smoke.mjs",
		"test:sandbox": "pnpm build:shared && node tests/sandbox-smoke.mjs",
		"test:sandbox:read-boundary": "pnpm build:shared && node tests/sandbox-read-boundary-smoke.mjs",
		"test:runtime": "node --test tests/runtime-packaging.test.mjs tests/pi-runtime-packaging.test.mjs tests/pi-update.test.cjs tests/license-cleanup.test.cjs",
		"test:codex:features": "pnpm build:shared && node tests/codex-features-smoke.mjs",
		"test:codex:history": "pnpm build:shared && node tests/codex-history-smoke.mjs",
		"test:local": "pnpm check && pnpm test:host && pnpm test:regressions && pnpm test:runtime && pnpm test:tooling && node --test tests/pi-handoff-context.test.mjs",
		"test:ui": "pnpm test:storybook && pnpm ui-review",
		"test:environment": "pnpm test:vsix && pnpm test:pi:chat && pnpm test:codex && pnpm test:acceptance",
		"test:acceptance": "pnpm test:codex:chat && pnpm test:codex:features && pnpm test:codex:history && pnpm test:pi:subagents && pnpm test:pi:workflow && pnpm test:pi:shell && pnpm test:pi:web && pnpm test:sandbox && pnpm test:sandbox:read-boundary && pnpm test:guardrails:ui && pnpm test:workflow:ui && pnpm test:sandbox:ui && node tests/header-smoke.mjs && node tests/composer-context-menu-smoke.mjs && node tests/launch-smoke.mjs && node tests/installed-smoke.mjs",
		"build:shared": "pnpm --filter @nerita/shared build",
		"build:ui": "pnpm --filter @nerita/ui build",
		"build:vscode": "pnpm --filter nerita build",
		"build": "pnpm build:shared && pnpm build:ui && pnpm build:vscode",
		"test-watch:types": "tsc --noEmit --watch --project tests/tsconfig.json",
		"test-watch:bundle": "node config/build-vscode-tests.cjs --watch"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.99.1",
		"@eslint/js": "^10.0.1",
		"@nerita/shared": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
		"@textlint-rule/textlint-rule-pattern": "^2.0.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.137.0",
		"@vitest/coverage-v8": "latest",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.0",
		"globals": "^17.12.0",
		"ignore": "^7.0.10",
		"lexical": "^0.50.0",
		"npm-run-all": "^4.1.5",
		"playwright": "latest",
		"prettier": "^3.9.6",
		"smol-toml": "^1.8.0",
		"textlint": "^15.8.0",
		"textlint-rule-preset-ja-technical-writing": "^12.0.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vite": "^8.3.0",
		"vitest": "latest",
		"zod": "^4.6.5"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}
