{
	"name": "nerita-workspace",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"handoff:generate": "node scripts/generate-handoff-schema.cjs",
		"guardrails:generate": "node scripts/generate-guardrails-schema.cjs",
		"codex:generate": "node config/generate-codex.cjs",
		"pi:generate": "node config/generate-pi.cjs",
		"pi:verify": "pnpm check && pnpm test:distribution",
		"compile": "pnpm check-types && pnpm lint && pnpm build",
		"package": "pnpm check-types && pnpm lint && pnpm build:shared && pnpm --filter @nerita/ui build --production && pnpm --filter nerita package",
		"package:vsix": "pnpm --filter nerita package:vsix",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "pnpm build:shared && pnpm --filter nerita watch",
		"watch:tsc": "pnpm --filter nerita exec tsc --noEmit --watch -p tsconfig.json",
		"watch:webview": "pnpm --filter @nerita/ui exec svelte-check --watch --tsconfig tsconfig.json --fail-on-warnings",
		"check": "pnpm test:eslint && pnpm lint && pnpm check-types && pnpm check-types:tests && pnpm duplication:ai",
		"check-types": "pnpm --filter nerita check && pnpm --filter @nerita/shared check && pnpm --filter @nerita/ui check && pnpm --filter @nerita/dlc check",
		"check-types:tests": "tsc --noEmit -p tests/tsconfig.json",
		"lint": "eslint . --cache --cache-strategy content",
		"lint:readability": "node config/eslint/audit.cjs",
		"lint:fix": "eslint . --fix --cache --cache-strategy content",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"duplication": "jscpd",
		"duplication:ai": "jscpd --reporters ai",
		"duplication:ci": "jscpd --baseline-from-ref origin/main --fail-on-new-clones --reporters ai",
		"duplication:report": "jscpd --reporters console,html",
		"storybook": "pnpm --filter @nerita/ui storybook",
		"build-storybook": "pnpm --filter @nerita/ui build-storybook",
		"test:storybook": "pnpm --filter @nerita/ui test:storybook",
		"build:shared": "pnpm --filter @nerita/shared build",
		"build:ui": "pnpm --filter @nerita/ui build",
		"build:vscode": "pnpm --filter nerita build",
		"build": "pnpm build:shared && pnpm --filter @nerita/dlc build && pnpm build:ui && pnpm build:vscode",
		"test": "node config/test-products.cjs",
		"test:eslint": "node --test tests/tooling/eslint/*.test.cjs",
		"test:product": "node config/test-products.cjs",
		"test:external": "node config/test-products.cjs --external",
		"test:regressions": "node config/test-products.cjs --regressions",
		"test:local": "pnpm check && pnpm test:product",
		"test:distribution": "node config/test-distribution.cjs",
		"test:windows": "node config/test-distribution.cjs --sandbox",
		"test:webview": "node config/test-distribution.cjs --ui",
		"verify": "pnpm test:local && pnpm test:distribution"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@eslint/js": "^10.0.1",
		"@nerita/dlc": "workspace:*",
		"@nerita/shared": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@types/node": "24.x",
		"@types/vscode": "^1.137.0",
		"@vitest/eslint-plugin": "^1.6.27",
		"@vscode/test-electron": "^3.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-storybook": "^10.6.0",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "^17.12.0",
		"jscpd": "^5.4.0",
		"npm-run-all": "^4.1.5",
		"playwright": "latest",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"smol-toml": "^1.8.0",
		"svelte-eslint-parser": "1.8.0",
		"svelte2tsx": "^0.7.61",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"typescript-eslint-parser-for-extra-files": "0.9.0",
		"zod": "^4.6.5"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}
